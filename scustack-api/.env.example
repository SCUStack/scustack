# Database
SCUSTACK_DB_HOST=localhost
SCUSTACK_DB_PORT=5432
SCUSTACK_DB_USER=scustack
SCUSTACK_DB_PASSWORD=scustack
SCUSTACK_DB_NAME=scustack
SCUSTACK_DB_POOL_SIZE=20

# Redis
SCUSTACK_REDIS_URL=redis://localhost:6379/0
SCUSTACK_REDIS_CONNECT_TIMEOUT_SECONDS=0.2

# Elasticsearch
SCUSTACK_ES_HOST=http://localhost:9200

# Alibaba Cloud OSS
SCUSTACK_OSS_ACCESS_KEY_ID=
SCUSTACK_OSS_ACCESS_KEY_SECRET=
SCUSTACK_OSS_ENDPOINT=
SCUSTACK_OSS_BUCKET=

# Storage provider
SCUSTACK_STORAGE_DEFAULT_PROVIDER=lfs
SCUSTACK_STORAGE_TARGET_REPLICA_COUNT=1
SCUSTACK_STORAGE_DOWNLOAD_GATEWAY=https://download.cacode.qzz.io

# LFS / CloudFlare ImgBed gateway. Keep the token in deployment secrets only.
SCUSTACK_LFS_UPLOAD_URL=https://lfs.cacode.qzz.io/upload
SCUSTACK_LFS_PUBLIC_BASE=https://lfs.cacode.qzz.io
SCUSTACK_LFS_API_TOKEN=
SCUSTACK_LFS_AUTH_HEADER=Authorization
SCUSTACK_LFS_AUTH_PREFIX=Bearer
SCUSTACK_LFS_UPLOAD_FIELD=file

# JWT
SCUSTACK_JWT_SECRET_KEY=change-me-in-production

# Encryption (AES-256-GCM for PII)
SCUSTACK_ENCRYPTION_KEY=change-me-in-production

# App
SCUSTACK_DEBUG=false
SCUSTACK_TRUSTED_HOSTS=["api.example.com"]
SCUSTACK_COOKIE_SECURE=true
